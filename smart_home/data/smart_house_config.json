{
    "hub": { "nome": "Smart House", "versao": "1.0" },
    "routines": {
    "leaving_home": [
      {
        "type": "door",
        "device_id": "entrance_door",
        "target_state": "LOCKED"
      },
      {
        "type": "bulb",
        "device_id": "living_room_bulb",
        "target_state": "OFF"
      },
      {
        "type": "outlet",
        "device_id": "living_room_outlet",
        "target_state": "OFF"
      },
      {
        "type": "thermostat",
        "device_id": "living_room_thermostat",
        "target_state": "IDLE",
        "target_temperature": 25.0
      },
      {
        "type": "sprinkler",
        "device_id": "garden_sprinkler",
        "target_state": "WATERING"
      },
      {
        "type": "camera",
        "device_id": "security_cam",
        "target_state": "RECORDING"
      }
    ],
    "good_night": [
      {
        "type": "door",
        "device_id": "living_room_door",
        "target_state": "LOCKED"
      },
      {
        "type": "bulb",
        "device_id": "living_room_bulb",
        "target_state": "ON",
        "attributes": {
          "brightness": 30,
          "color": "COOL"
        }
      },
      {
        "type": "thermostat",
        "device_id": "living_room_thermostat",
        "target_state": "COOLING",
        "attributes": {
          "target_temperature": 18
        }
      },
      {
        "type": "camera",
        "device_id": "security_cam",
        "target_state": "RECORDING"
      }
    ]
  }
}